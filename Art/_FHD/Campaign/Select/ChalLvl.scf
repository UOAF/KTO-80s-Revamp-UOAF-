##################
[WINDOW] GAME PANEL
[SETUP] CHALLENGE_WIN C_TYPE_NORMAL 900 700
[RANGES] 0 0 1920 1080 900 700
[XY] "centralized"
[GROUP] 4005
[DRAGH] 47
[FLAGBITON] C_BIT_DRAGABLE
[FLAGBITON] C_BIT_TRANSLUCENT
#apperently not used
[CLIENTAREA] 123 36 170 19 2 "Save file name"
#Start Generated Stuff - apperently not used
[CLIENTAREA] 2 2 308 22 1

