#UI BMS 4.38 update, December 2023, by Kolbe

#This is the right toolbar in a Tactical Engagement mission when the map is full screen.
#It contains following buttons:
#- Exit
#- Help
#- Map buttons
#- Team, Add, Flight buttons
#- Tools, Weather, DTC buttion
#- Fly button


##################
#WINDOW SETUP
##################

[WINDOW]
[SETUP] TAC_FULLMAP_WIN C_TYPE_NORMAL 1920 1080
[RANGES] 0 0 1920 1080 1920 1080
[XY] 0 0
[CLIENTAREA] 0 0 1860 1065
[GROUP] 3700
[FLAGBITON] C_BIT_CANTMOVE
[DEPTH] 15
[OPENCLIENTMENU] 0 MAP_POP

[TILE]
[SETUP] NID 0 BACKBUILDER
[XYWH] 1860 0 60 1080
[FLAGBITON] C_BIT_ABSOLUTE
[FLAGBITON] C_BIT_HORIZONTAL

#####  Background image
