##################
#BUTTONS
##################

#Activate a new team
[BUTTON]
[SETUP] TAC_NEW, C_TYPE_NORMAL, 200 0
[IMAGES] BTN_155_40_DARK, BTN_155_40_DARK, NULL, BTN_155_40_DARK
[FLAGBITON] C_BIT_ABSOLUTE
[LABELALL] TXT_NEW
[FONT] BANK_GOTHIC_24
[UPCOLOR] 191 191 191
[DOWNCOLOR] 0 255 0 GREEN
[DISCOLOR] 102 102 102
[TEXTOFFSET] C_STATE_UP 0 -1
[TEXTOFFSET] C_STATE_DOWN -1 0
[SOUNDBITE] SND_PUSH C_TYPE_LMOUSEDOWN
[GROUP] 3200
[CURSOR] CRSR_F16_ON
[HELPTEXT] HELP_NEW

#Deactivate current team
[BUTTON]
[SETUP] TAC_DELETE_TEAM, C_TYPE_NORMAL, 400 0
[IMAGES] BTN_155_40_DARK, BTN_155_40_DARK, NULL, BTN_155_40_DARK
[FLAGBITON] C_BIT_ABSOLUTE
[LABELALL] TXT_DELETE
[FONT] BANK_GOTHIC_24
[UPCOLOR] 191 191 191
[DOWNCOLOR] 0 255 0 GREEN
[DISCOLOR] 102 102 102
[TEXTOFFSET] C_STATE_UP 0 -1
[TEXTOFFSET] C_STATE_DOWN -1 0
[SOUNDBITE] SND_PUSH C_TYPE_LMOUSEDOWN
[GROUP] 19500
[CURSOR] CRSR_F16_ON
[HELPTEXT] HELP_DELETE


