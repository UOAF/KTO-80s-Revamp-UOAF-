#UI BMS4, created by Revientor (2009)
#Updated by Revientor 2017 to use the original 4:3 movie format Hi-Quality

[WINDOW]
#UI window width. 4:3: 668 508. 16:9: 880 508.
[SETUP] VIDEO_WIN C_TYPE_EXCLUSIVE 1920 1080
#Windows x/y. 4:3: 178 130. 16:9: 72 130.
[XY] 0 0
#Video output coords inside the UI window. 4:3: 14 14 640 480. 16:9: 14 14 852 480.
#w=video width - 28
#h=video height - 28
[RANGES] 0 0 1920 1080 1920 1080
[CLIENTAREA] 0 0 1920 1080 0
[FONT] OCR_EXT_14
[FLAGBITON] C_BIT_CANTMOVE
[FLAGBITON] C_BIT_TRANSLUCENT
[DEPTH] 12
[GROUP] 19300

[TILE]
[SETUP] NID 0 VIDEO
#UI window width. 4:3: 668 508. 16:9: 880 508.
[XYWH] 0 0 1920 1080
[FLAGBITON] C_BIT_ABSOLUTE
[FLAGBITON] C_BIT_HORIZONTAL

[TEXT]
[SETUP] NID C_TYPE_LEFT
[SETTEXT] VIDEO_SKIP
[XY] 5 5
[FONT] OCR_EXT_16
[FGCOLOR] 255 255 255 WHITE
[FLAGBITON] C_BIT_LEFT
[FLAGBITON] C_BIT_ABSOLUTE

# #1 pixel thick box around rendered video
# [BOX]
# [SETUP] NID, 0
# #w=video size + 1
# #h=video size + 1
# [XYWH] 13 13 641 481
# [COLOR] 65 128 173
# [FLAGBITON] C_BIT_ABSOLUTE