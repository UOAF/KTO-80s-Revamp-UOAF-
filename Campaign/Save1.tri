//////////////////////////////////////////////////////////////////////////////
// Base event file
//////////////////////////////////////////////////////////////////////////////

//////////////////////////////////////////////////////////////////////////////
// #TOTAL_EVENTS is a required entry, and
// should be # of events we have triggers for
// and code fore
// KCK WARNING: KEEP THIS UPDATED!
//////////////////////////////////////////////////////////////////////////////
#TOTAL_EVENTS 22

//////////////////////////////////////////////////////////////////////////////
// #SET_EVENT will set the activated flag for any
// events we want to be initially activate
// ie: Seoul already should be marked as
// captured in the Pusan parameter scenario
//
// This marks the ROK as initially on the defensive
//////////////////////////////////////////////////////////////////////////////
#SET_EVENT 10

// This set initial priorities
//////////////////////////////////////////////////////////////////////////////
#SET_EVENT 12

//////////////////////////////////////////////////////////////////////////////
// This sets the initial tempo
//////////////////////////////////////////////////////////////////////////////
#SET_TEMPO 150

//////////////////////////////////////////////////////////////////////////////
// Initialization section done
//////////////////////////////////////////////////////////////////////////////
#ENDINIT


//////////////////////////////////////////////////////////////////////////////
// Event #1
// Seoul being attacked by DPRK forces (DPRK controls a key cities close)
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 1
	#IF_CONTROLLED 6 OR 1162 1818 314 2182 1460 1788
		//#PLAY_MOVIE 100
		#SET_TEMPO 255
		#DO_EVENT 1
		#DO_MONOLOG Seoul being attacked by DPRK forces
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #2
// Seoul falls/regained
// When Seoul is taken, DPRK will push south to Yongin-Si
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 2
	#IF_CONTROLLED 6 AND 1722 314 1746 1726
		//#PLAY_MOVIE 101
		#SET_PAK_PRIORITY 6 2180 100
		#SET_PAK_PRIORITY 6 3228 50
		#DO_EVENT 2
		#DO_MONOLOG Seoul falls, pushback before it is too late!
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #3
// Pyongyang being attacked by ROK forces (ROK controls a key cities close)
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 3
	#IF_CONTROLLED 2 OR 1446 2102 1812 865
		//#PLAY_MOVIE 102
		#SET_TEMPO 255
		#DO_EVENT 3
		#DO_MONOLOG P'yongyang being attacked by ROK forces
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #4
// Pyongyang falls/regained
// When Pyongyang is taken, ROK will push north to Sunch'on
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 4
	#IF_CONTROLLED 2 AND 2122 2124 1448
		//#PLAY_MOVIE 103
		#SET_PAK_PRIORITY 2 1382 100
		#SET_PAK_PRIORITY 2 2122 50
		#DO_EVENT 4
		#DO_MONOLOG Pyongyang falls
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #5
// DPRK advanced beyond DMZ
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 5
	#IF_NOT_EVENT_PLAYED 7
		#IF_CONTROLLED 6 OR 204 3453 477 148 3583 147 877 883 887 1006
			#DO_EVENT 5
			#SHIFT_INITIATIVE 2 6 30
			#RESET_EVENT 6
			#DO_MONOLOG DPRK advanced beyond DMZ
		#ENDIF
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #6
// DPRK pushed back to DMZ
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 5
	#IF_CONTROLLED 2 AND 204 3453 477 148 3583 147 877 883 887 1006
		//#PLAY_MOVIE 104
		#DO_EVENT 6
		#RESET_EVENT 5
		#DO_MONOLOG DPRK pushed back to DMZ
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #7
// Combined forces advanced beyond DMZ
// 
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 7
	#IF_NOT_EVENT_PLAYED 5
		#IF_CONTROLLED 2 OR 1346 4378 3022 3021 3019 3020 3016 3013 3012 3025 190 3260
			#DO_EVENT 7
			#RESET_EVENT 8
			#DO_MONOLOG Combined forces advanced beyond DMZ
		#ENDIF
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #8
// Combined forces pushed back to DMZ
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 7
	#IF_EVENT_PLAYED 5
		//#PLAY_MOVIE 105
		#DO_EVENT 8
		#RESET_EVENT 7
		#DO_MONOLOG Combined forces pushed back to DMZ
	#ELSE
		#IF_CONTROLLED 6 AND 1346 4378 3022 3021 3019 3020 3016 3013 3012 3025 190 3260
			//#PLAY_MOVIE 105
			#DO_EVENT 8
			#RESET_EVENT 7
			#DO_MONOLOG Combined forces pushed back to DMZ
		#ENDIF
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #9
// Combined forces go on offensive
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 10
	#IF_ON_OFFENSIVE 2
		//#PLAY_MOVIE 106
		#DO_EVENT 9
		#SET_PAK_PRIORITY 2 2122 100
		#SET_PAK_PRIORITY 2 3228 50
		#RESET_PAK_PRIORITY 2 1488
		#RESET_PAK_PRIORITY 2 1344
		#SHIFT_INITIATIVE 6 2 20
		#RESET_EVENT 10
		#DO_MONOLOG Combined forces go on offensive
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #10
// Combined forces go on defensive
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 9
	#IF_ON_OFFENSIVE 6
		//#PLAY_MOVIE 107
		#DO_EVENT 10
		#RESET_EVENT 9
		#DO_MONOLOG Combined forces go on defensive
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #11
// China and Russia joins the war / Japan joins ROK
// By US/ROK controlling any of the following
// Souther Sector Kaesong or Hoeyang
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 11
	#IF_CONTROLLED 2 OR 1488 1344
		//#PLAY_MOVIE 108
		//PRC - DDPRK - Allied
		#CHANGE_RELATIONS 5 6 1
		//USSR - DPRK - Allied
		#CHANGE_RELATIONS 4 6 1
		//IJA - USA - Allied
		#CHANGE_RELATIONS 3 2 1
		#DO_EVENT 11
		#DO_MONOLOG China and Russia join DPRK war effort - Japan joins ROK
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #12
// Init Priorities
// ROK is defensive and protects Seoul from invasion
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 12
	#SET_PAK_PRIORITY 2 3228 40
	#SET_PAK_PRIORITY 2 1488 90
	#SET_PAK_PRIORITY 2 1344 80
	#SET_PAK_PRIORITY 2 2122 20
	#SET_PAK_PRIORITY 6 2122 20
	#SET_PAK_PRIORITY 6 3228 100
	#RESET_EVENT 12
	#DO_MONOLOG Init Priorities for Campaign
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #14
// Bad guys win
// DPRK reached Seoul South
//////////////////////////////////////////////////////////////////////////////
#IF_CONTROLLED 6 AND 1746
	//#PLAY_MOVIE 113
	#DO_EVENT 14
	#END_GAME 14
	#DO_MONOLOG DPRK reached Yongin-Si, Seoul is lost! -> END GAME
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #15
// Stalemate
//////////////////////////////////////////////////////////////////////////////
#IF_BORDOM_HOURS 480
	//#PLAY_MOVIE 114
	#DO_EVENT 15
	#END_GAME 15
	#DO_MONOLOG Stalemate -> END GAME
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #16
// Timeout
//////////////////////////////////////////////////////////////////////////////
#IF_CAMPAIGN_DAY >= 10
	//#PLAY_MOVIE 115
	#DO_EVENT 16
	#END_GAME 16
	#DO_MONOLOG Timeout -> END GAME
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #17
// We win - hu-rah!
// ROK reached Pyongyang!
//////////////////////////////////////////////////////////////////////////////
#IF_CONTROLLED 2 AND 2122
	//#PLAY_MOVIE 116
	#DO_EVENT 17
	#END_GAME 17
	#DO_MONOLOG ROK reached Sunch'on, Pyongyang is lost! -> END GAME
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #18
// China Enters War After Day 3
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 18
	#IF_CAMPAIGN_DAY >= 3
	   //PRC - DDPRK - Allied
		#CHANGE_RELATIONS 5 6 1
		//
		//PRC - ROK - At War
		#CHANGE_RELATIONS 5 2 5
		//PRC - USA - At War
		#CHANGE_RELATIONS 5 1 5
		//PRC - IJA - At War
		#CHANGE_RELATIONS 5 3 5
		//USA - PRC - At War
		#CHANGE_RELATIONS 1 5 5
		//ROK - PRC - At War
		#CHANGE_RELATIONS 2 5 5
		//IJA - PRC - At War
		#CHANGE_RELATIONS 3 5 5
		#SET_PAK_PRIORITY 5 2122 100
		#SET_PAK_PRIORITY 5 1850 75
		#SET_PAK_PRIORITY 5 3228 10
		#DO_EVENT 18
		#DO_MONOLOG China is now at war with coalition
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #19
// USSR Enters War After Day 1
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 19
	#IF_CAMPAIGN_DAY >= 2
		//USSR - DPRK - Allied
		#CHANGE_RELATIONS 4 6 1
		//
		//USSR - ROK - At War
		#CHANGE_RELATIONS 4 2 5
		//USSR - USA - At War
		#CHANGE_RELATIONS 4 1 5
		//USSR - IJA - At War
		#CHANGE_RELATIONS 4 3 5
		//USA - USSR - At War
		#CHANGE_RELATIONS 1 4 5
		//ROK - USSR - At War
		#CHANGE_RELATIONS 2 4 5
		//IJA - USSR - At War
		#CHANGE_RELATIONS 3 4 5
		#SET_PAK_PRIORITY 4 2122 100
		#SET_PAK_PRIORITY 4 1850 75
		#SET_PAK_PRIORITY 4 3228 10
		#DO_EVENT 19
		#DO_MONOLOG USSR is now at war with coalition
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #20
// Resupply control
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 20
	#IF_SUPPLY 6 <= 1000
		#SET_MINIMUM_SUPPLIES 1 2000 2000 5
		#SET_MINIMUM_SUPPLIES 2 2000 2000 5
		#SET_MINIMUM_SUPPLIES 3 2000 2000 5
		#SET_MINIMUM_SUPPLIES 4 2000 2000 5
		#SET_MINIMUM_SUPPLIES 5 2000 2000 5
		#SET_MINIMUM_SUPPLIES 6 2000 2000 5
		#SET_MINIMUM_SUPPLIES 7 2000 2000 5
		#DO_EVENT 20
		#RESET_EVENT 20
		#DO_MONOLOG Resupply control
	#ELSE
		#IF_SUPPLY 2 <= 1000
			#SET_MINIMUM_SUPPLIES 1 2000 2000 5
			#SET_MINIMUM_SUPPLIES 2 2000 2000 5
			#SET_MINIMUM_SUPPLIES 3 2000 2000 5
			#SET_MINIMUM_SUPPLIES 4 2000 2000 5
			#SET_MINIMUM_SUPPLIES 5 2000 2000 5
			#SET_MINIMUM_SUPPLIES 6 2000 2000 5
			#SET_MINIMUM_SUPPLIES 7 2000 2000 5
			#DO_EVENT 20
			#RESET_EVENT 20
			#DO_MONOLOG Resupply control
		#ENDIF	
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #21
// keep DPRK initiative up
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 21
	#IF_INITIATIVE 6 <= 65
		#SHIFT_INITIATIVE 2 6 10 
		#DO_EVENT 21
		#RESET_EVENT 21
		#DO_MONOLOG DPRK initiative boost
	#ENDIF		
	#IF_INITIATIVE 5 <= 65
		#SHIFT_INITIATIVE 1 5 10
		#DO_EVENT 21
		#RESET_EVENT 21
		#DO_MONOLOG PRC initiative boost		
	#ENDIF						
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #22
// If DPRK initiative is too high, boost ROK initiative
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 22
	#IF_INITIATIVE 6 >= 90
        #SHIFT_INITIATIVE 6 2 20 
        #DO_EVENT 22
		#RESET_EVENT 22
		#DO_MONOLOG ROK initiative boost		
	#ENDIF
	#IF_INITIATIVE 5 >= 90
        #SHIFT_INITIATIVE 5 1 10
        #DO_EVENT 22
		#RESET_EVENT 22
		#DO_MONOLOG US initiative boost		
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Script done
//////////////////////////////////////////////////////////////////////////////
#ENDSCRIPT