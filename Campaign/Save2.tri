//////////////////////////////////////////////////////////////////////////////
// Base event file
//////////////////////////////////////////////////////////////////////////////

//////////////////////////////////////////////////////////////////////////////
// #TOTAL_EVENTS is a required entry, and
// should be # of events we have triggers for
// and code fore
// KCK WARNING: KEEP THIS UPDATED!
//////////////////////////////////////////////////////////////////////////////
#TOTAL_EVENTS 22

//////////////////////////////////////////////////////////////////////////////
// #SET_EVENT will set the activated flag for any
// events we want to be initially activate
// ie: Seoul already should be marked as
// captured in the Pusan parameter scenario
//
// This marks the ROK as initially on the defensive
//////////////////////////////////////////////////////////////////////////////
#SET_EVENT 10

// This set initial priorities
//////////////////////////////////////////////////////////////////////////////
#SET_EVENT 12

//////////////////////////////////////////////////////////////////////////////
// This sets the initial tempo
//////////////////////////////////////////////////////////////////////////////
#SET_TEMPO 150

//////////////////////////////////////////////////////////////////////////////
// Initialization section done
//////////////////////////////////////////////////////////////////////////////
#ENDINIT


//////////////////////////////////////////////////////////////////////////////
// Event #1
// Daegu being attacked by DPRK forces (DPRK controls a key cities close)
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 1
	#IF_CONTROLLED 6 OR 274 612 306 617
		#SET_TEMPO 255
		#DO_EVENT 1
		#DO_MONOLOG Daegu being attacked by DPRK forces
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #2
// Daegu falls/regained
// When Daegu is taken, DPRK will push south to Busan
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 2
	#IF_CONTROLLED 6 AND 1862
		#PLAY_MOVIE 101
		#SET_PAK_PRIORITY 6 1334 100
		#RESET_PAK_PRIORITY 6 1862
		#DO_EVENT 2
		#DO_MONOLOG Daegu falls, pushback before it is too late!
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #3
// Seoul being attacked by ROK forces (ROK controls a key cities close)
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 3
	#IF_CONTROLLED 2 OR 1162 1818 314 2182 1460 1788
		#PLAY_MOVIE 102
		#SET_TEMPO 255
		#DO_EVENT 3
		#DO_MONOLOG Seoul being attacked by ROK forces
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #4
// Seoul falls/regained
// When Seoul is taken, ROK will push north to Pyongyang
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 4
	#IF_CONTROLLED 2 AND 3228
		#PLAY_MOVIE 103
		#SET_PAK_PRIORITY 2 2122 100
		#SET_PAK_PRIORITY 2 3228 50
		#RESET_PAK_PRIORITY 2 2180
		#RESET_PAK_PRIORITY 2 1336
		#SET_PAK_PRIORITY 6 3228 100
		#RESET_PAK_PRIORITY 6 1862
		#RESET_PAK_PRIORITY 6 2122
		#DO_EVENT 4
		#DO_MONOLOG Seoul Regained!
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #5
// DPRK advanced beyond DMZ
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 5
	#IF_NOT_EVENT_PLAYED 7
		#IF_CONTROLLED 6 OR 204 3453 477 148 3583 147 877 883 887 1006
			#DO_EVENT 5
			#RESET_EVENT 6
			#DO_MONOLOG DPRK advanced beyond DMZ
		#ENDIF
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #6
// DPRK pushed back to DMZ
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 5
	#IF_CONTROLLED 2 AND 204 3453 477 148 3583 147 877 883 887 1006
		#PLAY_MOVIE 104
		#DO_EVENT 6
		#RESET_EVENT 5
		#DO_MONOLOG DPRK pushed back to DMZ
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #7
// Combined forces advanced beyond DMZ
// 
//////////////////////////////////////////////////////////////////////////////
#IF_NOT_EVENT_PLAYED 7
	#IF_NOT_EVENT_PLAYED 5
		#IF_CONTROLLED 2 OR 1346 4378 3022 3021 3019 3020 3016 3013 3012 3025 190 3260
			#DO_EVENT 7
			#RESET_EVENT 8
			#DO_MONOLOG Combined forces advanced beyond DMZ
		#ENDIF
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #8
// Combined forces pushed back to DMZ
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 7
	#IF_EVENT_PLAYED 5
		#PLAY_MOVIE 105
		#DO_EVENT 8
		#RESET_EVENT 7
		#DO_MONOLOG Combined forces pushed back to DMZ
	#ELSE
		#IF_CONTROLLED 6 AND 1346 4378 3022 3021 3019 3020 3016 3013 3012 3025 190 3260
			#PLAY_MOVIE 105
			#DO_EVENT 8
			#RESET_EVENT 7
			#DO_MONOLOG Combined forces pushed back to DMZ
		#ENDIF
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #9
// Combined forces go on offensive
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 10
	#IF_ON_OFFENSIVE 2
		#PLAY_MOVIE 106
		#DO_EVENT 9
		#SET_PAK_PRIORITY 2 2122 100
		#SET_PAK_PRIORITY 2 3228 50
		#SHIFT_INITIATIVE 6 2 20
		#RESET_EVENT 10
		#DO_MONOLOG Combined forces go on offensive
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #10
// Combined forces go on defensive
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 9
	#IF_ON_OFFENSIVE 6
		#PLAY_MOVIE 107
		#DO_EVENT 10
		#RESET_EVENT 9
		#DO_MONOLOG Combined forces go on defensive
	#ENDIF
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #12
// Init Priorities
// ROK is defensive and protects Seoul from invasion
//////////////////////////////////////////////////////////////////////////////
#IF_EVENT_PLAYED 12
	#SET_PAK_PRIORITY 2 3228 100
	#SET_PAK_PRIORITY 2 2180 90
	#SET_PAK_PRIORITY 2 1336 80
	#SET_PAK_PRIORITY 2 2122 10
	#SET_PAK_PRIORITY 6 2122 10
	#SET_PAK_PRIORITY 6 3228 50
	#SET_PAK_PRIORITY 6 1862 100
	#RESET_EVENT 12
	#DO_MONOLOG Init Priorities for Campaign
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #14
// Bad guys win
// DPRK reached Busan, War is lost!
//////////////////////////////////////////////////////////////////////////////
#IF_CONTROLLED 6 AND 1334
	#PLAY_MOVIE 113
	#DO_EVENT 14
	#END_GAME 14
	#DO_MONOLOG DPRK reached Busan, War is lost! -> END GAME
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #15
// Stalemate
//////////////////////////////////////////////////////////////////////////////
#IF_BORDOM_HOURS 480
	#PLAY_MOVIE 114
	#DO_EVENT 15
	#END_GAME 15
	#DO_MONOLOG Stalemate -> END GAME
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #16
// Timeout
//////////////////////////////////////////////////////////////////////////////
#IF_CAMPAIGN_DAY >= 30
	#PLAY_MOVIE 115
	#DO_EVENT 16
	#END_GAME 16
	#DO_MONOLOG Timeout -> END GAME
#ENDIF

//////////////////////////////////////////////////////////////////////////////
// Event #17
// We win - hu-rah!
// ROK reached Pyongyang or controls Seoul after 20 days
//////////////////////////////////////////////////////////////////////////////
#IF_CONTROLLED 2 AND 2122
	#PLAY_MOVIE 116
	#DO_EVENT 17
	#END_GAME 17
	#DO_MONOLOG ROK reached Pyongyang, War is over! -> END GAME
#ENDIF

#IF_CAMPAIGN_DAY >= 20
	#IF_CONTROLLED 2 AND 3228
		#DO_EVENT 17
		#END_GAME 17
		#DO_MONOLOG ROK controls back Seoul after 20 days, War is over! -> END GAME
	#ENDIF
#ENDIF


//////////////////////////////////////////////////////////////////////////////
// Script done
//////////////////////////////////////////////////////////////////////////////
#ENDSCRIPT